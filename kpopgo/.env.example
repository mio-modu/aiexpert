# Google Analytics 4 — dwell time and engagement are measured here, not in Search Console.
NEXT_PUBLIC_GA_ID=

# Google AdSense. Every slot stays hidden until its id is filled in, so the
# site looks finished during the weeks before approval.
# Find these in the AdSense dashboard after the site is approved.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_FOOT=
NEXT_PUBLIC_ADSENSE_SLOT_LIST=

# Search engine ownership verification. Both are meta tags on the homepage,
# and neither can be obtained before the domain resolves — register the site
# first, then paste the token here (Vercel → Settings → Environment Variables)
# and redeploy.
#
# Google:  Search Console → 속성 추가 → URL 접두어 → HTML 태그 → content="..."
# Naver:   서치어드바이저 → 사이트 등록 → HTML 태그 → content="..."
NEXT_PUBLIC_VERIFY_GOOGLE=
NEXT_PUBLIC_VERIFY_NAVER=
